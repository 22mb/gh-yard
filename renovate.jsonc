// Dependency updates. JSONC because the Renovate docs recommend it for commented
// config, and the reasoning belongs next to the settings.
//
// Cargo needs no manager entry: Renovate's `cargo` manager claims Cargo.toml and
// Cargo.lock itself. This file covers *version* updates only — disclosed CVEs
// surface through GitHub's security alerts (repo Settings -> Security), not here.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // GitHub Actions are pinned to a commit SHA with a trailing `# vX.Y.Z` comment
    // (supply-chain safety; sha_pinning_required is on for this repo). This preset
    // sets pinDigests for the github-actions manager, so anything added later
    // unpinned gets pinned too.
    "helpers:pinGitHubActionDigests"
  ],
  // Weekly. Five runtime dependencies and one dev dependency don't justify more.
  "schedule": ["before 6am on monday"],
  // Cargo.toml versions are ranges (bare `0.30.2` means `^0.30.2`). Renovate's
  // default would leave the manifest alone when the lockfile already satisfies a
  // new release, letting it drift from what's installed. `bump` keeps the
  // manifest honest.
  "rangeStrategy": "bump",
  // Don't propose a version until it has been public for three days. Hijacked
  // crate releases are typically caught within hours, so a short wait clears most
  // of that exposure — and it matters more than usual here, because non-major
  // updates below merge without anyone reading them. Security updates bypass
  // this. Note this only covers what Renovate itself bumps; transitive
  // dependencies move when Cargo.lock is regenerated and are not managed here.
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      // One PR a week for everything that isn't a major — including the GitHub
      // Action digest bumps, which move the SHA and its `# vX.Y.Z` comment
      // together. Majors stay on their own so they get read rather than skimmed
      // as part of a batch.
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major",
      // Merged without a human once the three required checks pass.
      // `platformAutomerge` (on by default) hands this to GitHub's own
      // auto-merge, so the branch ruleset still gates it.
      "automerge": true
    }
  ]
}
